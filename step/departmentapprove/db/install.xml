<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="admin/tool/lifecycle/step/departmentapprove/db" VERSION="2026071600" COMMENT="XMLDB file for Moodle lifecycle_step/email"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../../../../lib/xmldb/xmldb.xsd">
  <TABLES>
    <TABLE NAME="lifecyclestep_departmentapprove" COMMENT="table containing all mails which still have to be sent">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="20" NOTNULL="true" SEQUENCE="true" COMMENT="id of the mail"/>
        <FIELD NAME="contact" TYPE="char" LENGTH="150" NOTNULL="true" SEQUENCE="false" COMMENT="email address to which the email should go to"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="course the user should be informed about"/>
        <FIELD NAME="instanceid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="id of the step instance responsible"/>
        <FIELD NAME="processid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="confirmtoken" TYPE="char" LENGTH="64" NOTNULL="false" SEQUENCE="false" COMMENT="Token for confirming request"/>
        <FIELD NAME="confirmtokenexpires" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="status" TYPE="int" LENGTH="2" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="approval state"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
    </TABLE>
  </TABLES>
</XMLDB>